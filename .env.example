# Скопируй этот файл в .env.local и подставь свои значения.
# .env.local в гит не попадает — он уже в .gitignore.
#
# Те же переменные должны быть заданы в Vercel:
# Project Settings → Environment Variables.

# Адрес проекта Supabase и его публичный (anon) ключ.
# Ключ не секретный — он и так уходит в браузер; доступ к данным ограничивают
# политики RLS на стороне базы, а не скрытность ключа.
VITE_SUPABASE_URL=https://<ваш-проект>.supabase.co
VITE_SUPABASE_ANON_KEY=<публичный ключ проекта>

# Имя бота в Telegram (без @) и slug Mini App из BotFather.
# Нужны для реферальной ссылки t.me/{bot}/{app}?startapp=ref_X
VITE_BOT_USERNAME=<имя_бота>
VITE_APP_NAME=<slug_приложения>

# DSN проекта Sentry для сбора ошибок. Пусто — Sentry просто не включается.
VITE_SENTRY_DSN=

# ── Только для локальной разработки ────────────────────────────────────────
# Токен обновления живой сессии. Если он задан, dev-сборка (npm run dev) входит
# по нему сама, не спрашивая код с почты — чтобы можно было открыть любой экран
# в браузере и посмотреть его глазами.
#
# Где взять: войти в приложение по почте один раз, затем в консоли браузера
#   JSON.parse(localStorage.getItem(Object.keys(localStorage).find(k => k.includes('auth-token')))).refresh_token
#
# В боевую сборку эта ветка не попадает вовсе (вырезается по import.meta.env.DEV).
# Токен = доступ к аккаунту: держать только тут, в репозиторий не класть.
VITE_DEV_REFRESH_TOKEN=
